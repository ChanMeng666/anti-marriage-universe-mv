  "t0": 166.24,
  "t1": 168.6,
  "text": "阿花今年六十八",
  "s1": 169.0
 },
 {
  "id": "BR.1",
  "section": "BR",
  "t0": 169.1,
  "t1": 171.8,
  "text": "她早已不再需要家",
  "s1": 172.5
 },
 {
  "id": "BR.2",
  "section": "BR",
  "t0": 173.62,
  "t1": 176.3,
  "text": "那是父权编织的篱笆",
  "s1": 176.4
 },
 {
  "id": "BR.3",
  "section": "BR",
  "t0": 176.5,
  "t1": 180.6,
  "text": "她和姐妹在此刻 拥有了天下",
  "s1": 181.3
 },
