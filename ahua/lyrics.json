[
 {
  "id": "V1.0",
  "section": "V1",
  "t0": 17.76,
  "t1": 20.7,
  "text": "阿花今年二十八",
  "s1": 21.1
 },
 {
  "id": "V1.1",
  "section": "V1",
  "t0": 21.2,
  "t1": 23.9,
  "text": "早已看透父权虚假",
  "s1": 24.6
 },
 {
  "id": "V1.2",
  "section": "V1",
  "t0": 24.82,
  "t1": 27.0,
  "text": "相亲对象那个阿发",
  "s1": 27.2
 },
 {
  "id": "V1.3",
  "section": "V1",
  "t0": 27.3,
  "t1": 31.1,
  "text": "张口闭口不仅是爹味 甚至还有点大",
  "s1": 31.8
 },
 {
  "id": "V1.4",
  "section": "V1",
  "t0": 32.32,
  "t1": 34.5,
  "text": "阿花冷眼看阿发",
  "s1": 35.2
 },
 {
  "id": "V1.5",
  "section": "V1",
  "t0": 36.0,
  "t1": 38.3,
  "text": "收起你那如意算盘吧",
  "s1": 38.64
 },
 {
  "id": "V1.6",
  "section": "V1",
  "t0": 38.74,
  "t1": 42.2,
  "text": "想要保姆请你自己花钱雇佣她",
  "s1": 42.6
 },
 {
  "id": "V1.7",
  "section": "V1",
  "t0": 42.7,
  "t1": 45.1,
  "text": "别想白嫖我的年华",
  "s1": 45.64
 },
 {
  "id": "P1.0",
  "section": "P1",
  "t0": 45.74,
  "t1": 48.5,
  "text": "后来故事发展很火辣",
  "s1": 48.54
 },
 {
  "id": "P1.1",
  "section": "P1",
  "t0": 48.64,
  "t1": 52.2,
  "text": "阿花当场掀翻了名为传统的塔",
  "s1": 52.68
 },
 {
  "id": "P1.2",
  "section": "P1",
  "t0": 52.78,
  "t1": 54.4,
  "text": "什么旧爱新欢",
  "s1": 54.35
 },
 {
  "id": "P1.3",
  "section": "P1",
  "t0": 54.45,
  "t1": 56.0,
  "text": "都不care啊",
  "s1": 55.98
 },
 {
  "id": "P1.4",
  "section": "P1",
  "t0": 56.08,
  "t1": 58.0,
  "text": "什么贤妻良母的剧本",
  "s1": 57.96
 },
 {
  "id": "P1.5",
  "section": "P1",
  "t0": 58.06,
  "t1": 59.7,
  "text": "去死吧",
  "s1": 60.4
 },
 {
  "id": "C1.0",
  "section": "C1",
  "t0": 63.8,
  "t1": 67.6,
  "text": "觉醒吧 觉醒吧",
  "s1": 68.04
 },
 {
  "id": "C1.1",
  "section": "C1",
  "t0": 68.14,
  "t1": 71.0,
  "text": "就算王子真的骑着白马",
  "s1": 70.9
 },
 {
  "id": "C1.2",
  "section": "C1",
  "t0": 71.0,
  "t1": 74.6,
  "text": "也直接让他滚回城堡吧",
  "s1": 75.1
 },
 {
  "id": "C1.3",
  "section": "C1",
  "t0": 75.2,
  "t1": 78.6,
  "text": "我的广阔天地无需那个他",
  "s1": 78.6
 },
 {
  "id": "C1.4",
  "section": "C1",
  "t0": 78.7,
  "t1": 81.8,
  "text": "觉醒吧 战士阿花",
  "s1": 81.74
 },
 {
  "id": "C1.5",
  "section": "C1",
  "t0": 81.84,
  "t1": 84.9,
  "text": "少女的梦早已经死在昨天啦",
  "s1": 84.9
 },
 {
  "id": "C1.6",
  "section": "C1",
  "t0": 85.0,
  "t1": 88.4,
  "text": "那带血的束身衣扎成捧花",
  "s1": 88.3
 },
 {
  "id": "C1.7",
  "section": "C1",
  "t0": 88.4,
  "t1": 94.0,
  "text": "扔进火里烧了个稀里哗啦",
  "s1": 94.7
 },
 {
  "id": "V2.0",
  "section": "V2",
  "t0": 98.0,
  "t1": 100.9,
  "text": "阿发吓坏了看阿花",
  "s1": 101.1
 },
 {
  "id": "V2.1",
  "section": "V2",
  "t0": 101.2,
  "t1": 104.5,
  "text": "她剪掉长发洗去了妆容啊",
  "s1": 104.46
 },
 {
  "id": "V2.2",
  "section": "V2",
  "t0": 104.56,
  "t1": 107.7,
  "text": "一生一世这画饼太廉价",
  "s1": 108.4
 },
 {
  "id": "V2.3",
  "section": "V2",
  "t0": 108.8,
  "t1": 111.0,
  "text": "独行出发吧",
  "s1": 111.7
 },
 {
  "id": "P2.0",
  "section": "P2",
  "t0": 114.82,
  "t1": 118.0,
  "text": "后来故事发展更潇洒",
  "s1": 118.3
 },
 {
  "id": "P2.1",
  "section": "P2",
  "t0": 118.4,
  "t1": 121.4,
  "text": "再也没有谁能等着阿花回家",
  "s1": 121.4
 },
 {
  "id": "P2.2",
  "section": "P2",
  "t0": 121.5,
  "t1": 124.9,
  "text": "一个人读书健身闯荡天下",
  "s1": 124.78
 },
 {
  "id": "P2.3",
  "section": "P2",
  "t0": 124.88,
  "t1": 128.2,
  "text": "搞搞事业也会研究研究代码",
  "s1": 128.9
 },
 {
